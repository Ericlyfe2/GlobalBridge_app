# API base URL — change to your staging/production URL
EXPO_PUBLIC_API_URL=http://localhost:4100

# Firebase config (use expo-constants for runtime values, or hardcode in firebase config)

# Google Sign-In's "Web application" OAuth client, from Firebase console ->
# Authentication -> Sign-in method -> Google -> Web SDK configuration. Not a
# secret (it identifies the app, not a credential), but does not exist until
# Google is enabled as a sign-in provider for the project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
