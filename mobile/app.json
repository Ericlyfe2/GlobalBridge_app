{
  "expo": {
    "name": "GlobalBridge",
    "slug": "globalbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "globalbridge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.globalbridge.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0A1628"
      },
      "package": "app.globalbridge.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-router",
      [
        "expo-secure-store",
        {
          "clipboardPermission": "Allow GlobalBridge to access clipboard for verification codes."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ]
  }
}
