# GlobalBridge mobile API — environment
#
# Copy to .env. Nothing in this file is safe to put in a mobile bundle: every
# value here is a server-side credential or a server-side policy decision.
# The app receives only EXPO_PUBLIC_* values, and those are readable by anyone
# who downloads the binary.

NODE_ENV=development
PORT=4100

# ── Data ────────────────────────────────────────────────────────────────────
# Points at the same PostgreSQL 16 database the web platform uses. The schema
# is shared; the migrations in db/migrations are written to be idempotent so
# they reconcile a live database rather than fighting it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/globalbridge

# Optional. Without it the server still runs: WebSocket fan-out is
# single-instance and rate-limit counters are per-process.
# REDIS_URL=redis://localhost:6379

# ── Identity (required) ─────────────────────────────────────────────────────
# Firebase Admin service account. FIREBASE_PRIVATE_KEY keeps its literal \n
# sequences; the app un-escapes them at boot.
FIREBASE_PROJECT_ID=globalbridge
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@globalbridge.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ── Origins ─────────────────────────────────────────────────────────────────
# Comma-separated. A production native build sends no Origin header at all and
# needs no entry here; http://localhost:8081 is the Expo dev client.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ── Client version gate ─────────────────────────────────────────────────────
# Raising MIN_SUPPORTED_APP_VERSION locks out every build below it with a 426
# and a blocking update screen. It is a user-facing action, not a config tweak:
# anyone who cannot update — an old device, no storage, a country where the
# store is restricted — loses access to their visa checklist. Raise it only for
# a contract break or a security fix, never for convenience.
MIN_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
APP_UPDATE_URL_IOS=https://apps.apple.com/app/globalbridge/id000000000
APP_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=app.globalbridge

# Serves 503 + Retry-After to everything except /health and /app-config.
MAINTENANCE_MODE=

# ── Push ────────────────────────────────────────────────────────────────────
# Both optional. Absent, the server warns once at boot and sends become no-ops;
# notification rows and WebSocket delivery are unaffected, so nothing is lost —
# only the lock-screen alert.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@globalbridge.app

# Native push reuses the Firebase Admin credential above — no second secret.
# Set to 1 once FCM is enabled on the Firebase project and APNs is uploaded.
FCM_ENABLED=

# ── AI ──────────────────────────────────────────────────────────────────────
# Server-side only, permanently. The key never travels to a client.
# OPENAI_API_KEY=
